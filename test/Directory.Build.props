<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Add any shared properties you want for the projects under this directory that need to be set before the auto imported Directory.Build.props
  -->
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory).., Directory.Build.props))\Directory.Build.props" />

  <PropertyGroup Label="Compile settings">
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Atc.Test" Version="3.0.0" />
    <PackageReference Include="Atc.XUnit" Version="3.0.174" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.9.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="Neovolve.Logging.Xunit.v3" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Atc.Test" />
    <Using Include="Atc.XUnit" />
    <Using Include="AutoFixture" />
    <Using Include="AutoFixture.Xunit3" />
    <Using Include="AwesomeAssertions" />
    <Using Include="NSubstitute" />
    <Using Include="Xunit" />
    <Using Include="Neovolve.Logging.Xunit" />
  </ItemGroup>

</Project>