<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Atc" Version="3.0.186" />
    <!-- Log messages are rendered as Spectre markup by the consumers' console sink, so exception
         text interpolated into them has to be escaped. Pinned to the version already resolving
         transitively via Atc.Console.Spectre. -->
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>